# Keep Docker and devcontainer files in the build context
!Dockerfile
!docker-compose*.yml
!.devcontainer
!.devcontainer/**
!devcontainer.json
!requirements*.txt
!pyproject.toml
!poetry.lock
!Pipfile

# Ignore virtual environments and Python cache
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyre/
*.egg-info/
pip-wheel-metadata/
*.pybuildinfo

# Ignore local env and secrets
.env
.env.*
.envrc
secrets/
*.pem
*.key
*.local
*.secret
*.sqlite3

# Build / packaging / test output
build/
dist/
htmlcov/
coverage/
*.cover
coverage.xml
*.log
tmp/
out/

# IDE and OS
.vscode/
.idea/
*.sublime-*
.DS_Store
Thumbs.db
*.swp

# Node artifacts (if any frontend present)
node_modules/
npm-debug.log
yarn-error.log
.pnpm-store/

# Misc
*.bak
*.tmp